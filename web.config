<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- index.html como página padrão do site -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- o IIS não conhece .webp por padrão: sem isso ele recusa servir o arquivo -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- o site antigo (Canva) vivia em /home; o Google ainda indexa esse
             endereço. 301 permanente manda quem clica no link antigo para a raiz
             e avisa o Google para atualizar o índice. -->
        <rule name="home-antigo-para-raiz" stopProcessing="true">
          <match url="^home/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
